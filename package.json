{
  "name": "yuzic-engine",
  "version": "1.2.0",
  "description": "An audio playback engine for React Native, built on an audio graph: gapless playback, crossfade, equalizer, replay gain, caching and car support",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yuzicapp/yuzic-engine.git"
  },
  "homepage": "https://github.com/yuzicapp/yuzic-engine#readme",
  "bugs": {
    "url": "https://github.com/yuzicapp/yuzic-engine/issues"
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "source": "src/index.ts",
  "files": [
    "app.plugin.js",
    "expo-module.config.json",
    "ios",
    "android",
    "lib",
    "src",
    "!src/**/*.test.ts",
    "!android/src/test",
    "!android/build",
    "!ios/build",
    "LICENSE",
    "NOTICE",
    "CHANGELOG.md",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit && tsc -p tsconfig.build.json --noEmit",
    "test": "jest",
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build"
  },
  "keywords": [
    "react-native",
    "audio",
    "player",
    "crossfade",
    "equalizer"
  ],
  "peerDependencies": {
    "@expo/config-plugins": ">=55.0.0",
    "expo-modules-core": ">=55.0.0",
    "react-native": ">=0.83.0"
  },
  "devDependencies": {
    "@expo/config-plugins": "^57.0.9",
    "@types/jest": "^29.5.12",
    "expo-modules-core": "^57.0.16",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.12",
    "typescript": "~5.9.2"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/lib/"
    ]
  },
  "peerDependenciesMeta": {
    "expo-modules-core": {
      "optional": false
    },
    "@expo/config-plugins": {
      "optional": true
    }
  }
}
